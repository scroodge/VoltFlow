# Supabase configuration (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Site & canonical URLs
NEXT_PUBLIC_SITE_URL=https://voltflow.life
# Optional override for canonical telemetry endpoint:
# BYDMATE_TELEMETRY_ENDPOINT_URL=https://voltflow.life/api/bydmate/telemetry

# Server-only HMAC secrets / peppers (generate long random secrets)
BYDMATE_API_KEY_PEPPER=replace-with-a-long-random-secret
BYDMATE_LINK_CODE_PEPPER=replace-with-a-long-random-secret
BYDMATE_WEBHOOK_TOKEN_PEPPER=replace-with-a-long-random-secret

# Cron jobs authentication secret
CRON_SECRET=replace-with-a-long-random-secret

# Remote commands (disabled unless explicitly enabled)
REMOTE_COMMANDS_ENABLED=false

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your@email.com

# Telegram bot & Mini App integration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret
TELEGRAM_WEB_APP_URL=https://voltflow.life/telegram
# Developer's Telegram chat id: Mate «Отправить диагностику» bundles are relayed here
# (POST /api/bydmate/diagnostics). Unset → the endpoint answers 503.
TELEGRAM_DIAGNOSTICS_CHAT_ID=
# NEXT_PUBLIC_TELEGRAM_API_BASE_URL=https://api.telegram.org

# Email sending (Resend)
RESEND_API_KEY=re_your_resend_api_key

# LLM & AI Search configuration
OPENAI_API_KEY=your-openai-api-key
LLM_BASE_URL=https://your-llm-provider/v1
LLM_MODEL=qwen2.5:14b
LLM_API_KEY=your-api-key
LLM_MAX_TOKENS=512

# Donation page bank card numbers (src/lib/support.ts)
NEXT_PUBLIC_SUPPORT_CARD_BY=your-belarus-card-number
NEXT_PUBLIC_SUPPORT_CARD_RU=your-russia-card-number

# Legal operator details
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=your@email.com
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=YOURNAMEPROJECTNAME
NEXT_PUBLIC_LEGAL_OPERATOR_ADDRESS=YOURADDRESS

# Optional development flags
# DEV_ADMIN_EMAIL=admin@example.com
# ALLOW_DEBUG_DASHBOARD=false
# GITHUB_TOKEN=your-github-token
